{
	"name": "Spring Boot Auth Service",
	"image": "mcr.microsoft.com/devcontainers/java:17",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {},
		"ghcr.io/devcontainers/features/git:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	"forwardPorts": [8080, 8081, 8082, 5433, 6379, 9092],
	"portsAttributes": {
		"8080": {
			"label": "Spring Boot App",
			"onAutoForward": "notify"
		},
		"8081": {
			"label": "Kafka UI",
			"onAutoForward": "notify"
		},
		"8082": {
			"label": "pgAdmin",
			"onAutoForward": "notify"
		},
		"5433": {
			"label": "PostgreSQL",
			"onAutoForward": "silent"
		},
		"6379": {
			"label": "Redis",
			"onAutoForward": "silent"
		},
		"9092": {
			"label": "Kafka",
			"onAutoForward": "silent"
		}
	},
	"postCreateCommand": "mvn clean compile",
	"postStartCommand": "docker-compose -f docker-compose.yml -p authservice up -d",
	"remoteUser": "vscode",
	"mounts": [
		"source=${localWorkspaceFolder}/.devcontainer/scripts,target=/workspaces/scripts,type=bind,consistency=cached"
	]
}
